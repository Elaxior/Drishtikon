# ============================================================
# Environment Variables — NEVER commit secrets
# ============================================================
.env
.env.*
!.env.example      # allow the example/template file if you have one

# ============================================================
# Python / Backend
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing & coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# MyPy
.mypy_cache/

# ============================================================
# Node / Frontend
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/
.next/
out/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# ============================================================
# OS generated
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Misc
